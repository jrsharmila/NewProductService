	</parent>
	<groupId>com.sharmila</groupId>
	<artifactId>productservice</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>productservice</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
